# See docs/ENVIRONMENT.md for full reference
#
# Variable classes:
#   [required]        must be set in every environment
#   [required:prod]   must be set (and non-placeholder) in production
#   [optional]        has a safe default; override only when needed
#   [dev-only]        development convenience value; rejected in production
#
# Production startup runs the environment validation profile and refuses to
# boot on placeholder secrets, weak secrets, insecure transport, unsafe debug
# flags, or missing contract/network identifiers. See docs/ENVIRONMENT.md.

# [required:prod] Explicit environment selector. Production validation only
# runs when NODE_ENV=production; there is no silent fallback to dev defaults.
NODE_ENV=development

# [required:prod] Comma-separated allowed browser origins (no wildcard in prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
# [optional] One of: error, warn, info, http, debug. Falls back to debug (dev) / info (other envs) when unset or invalid.
LOG_LEVEL=
# [required:prod] Public frontend URL (must be https in production)
FRONTEND_URL=http://localhost:3000

# Server Configuration
# [optional] HTTP port
PORT=3001

# [required:prod] Database connection string
DATABASE_URL=postgres://postgres:postgres@db:5432/remitlend
# [required:prod] Redis connection string
# Docker default (use redis://localhost:6379 if running Redis outside docker-compose)
REDIS_URL=redis://redis:6379
# [optional] Database pool connection timeout in ms (default: 10000)
DB_CONN_TIMEOUT_MS=10000
# [optional] Database statement timeout in ms (default: 30000)
DB_STATEMENT_TIMEOUT_MS=30000

# Seed scenarios (issue #579)
# Active environment gate for seed/reset commands. Seed and reset refuse to run
# unless NODE_ENV is "development" (or "test"), or SEED_ALLOW_NON_DEV=true is set.
NODE_ENV=development
# Explicit safe override to allow seeding/resetting a non-development database.
# Leave false; only set true deliberately for disposable staging databases.
SEED_ALLOW_NON_DEV=false
# Named, versioned seed scenario to apply. One of:
#   pending | approved | partially_repaid | repaid | defaulted | disputed_score | degraded_service
# Each scenario is deterministic and idempotent (repeated runs do not duplicate records).
SEED_SCENARIO=pending
# Seed data schema version. Bump only when scenario shapes change incompatibly.
SEED_SCENARIO_VERSION=1
# Stable identifier prefix for seeded principals/loans so tests can reference them.
SEED_ID_PREFIX=seed

# Stellar Configuration
# [required:prod] Select network defaults ("testnet" or "mainnet")
STELLAR_NETWORK=testnet
# [optional] Override (defaults from STELLAR_NETWORK; must match selected network)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# [optional] Override (must match selected network exactly)
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# [required:prod] Contract identifiers (must be valid contract addresses in prod)
LOAN_MANAGER_CONTRACT_ID=
REMITTANCE_NFT_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
MULTISIG_GOVERNANCE_CONTRACT_ID=
POOL_TOKEN_ADDRESS=
STELLAR_USDC_ISSUER=
STELLAR_EURC_ISSUER=
STELLAR_PHP_ISSUER=
# [required:prod] Secret key for the on-chain LoanManager admin account (G... / S...)
LOAN_MANAGER_ADMIN_SECRET=
# [optional] Override for score reconciliation read calls
SCORE_RECONCILIATION_SOURCE_SECRET=
# Soroban RPC resilience (graceful degradation)
# [optional] Fail fast at startup when the RPC is unreachable (default: start degraded)
SOROBAN_REQUIRE_RPC_AT_STARTUP=false
# [optional] Timeout for a single RPC health probe in ms
SOROBAN_RPC_HEALTH_TIMEOUT_MS=1500
# [optional] How long a probe result is cached before the RPC is checked again, in ms
SOROBAN_RPC_HEALTH_CACHE_MS=3000
# [optional] Consecutive RPC failures before the circuit opens
SOROBAN_CIRCUIT_FAILURE_THRESHOLD=3
# [optional] How long the circuit stays open before a recovery attempt, in ms
SOROBAN_CIRCUIT_COOLDOWN_MS=15000
# [optional] How long a last-known read value stays usable while the RPC is down, in ms
SOROBAN_STALE_READ_TTL_MS=3600000
# [optional] How long read responses keep advertising the degradation warning, in ms
SOROBAN_STALE_WARNING_TTL_MS=60000
# [optional] How often the replay worker drains queued writes, in ms
SOROBAN_WRITE_REPLAY_INTERVAL_MS=15000
# [optional] Max queued writes replayed per pass
SOROBAN_WRITE_REPLAY_BATCH_SIZE=25
# [optional] Backoff base for a failed replay, in ms
SOROBAN_WRITE_BACKOFF_BASE_MS=5000
# [optional] Backoff ceiling for a failed replay, in ms
SOROBAN_WRITE_BACKOFF_MAX_MS=300000

# Loan configuration (required)
LOAN_MIN_SCORE=500
LOAN_MAX_AMOUNT=50000
LOAN_INTEREST_RATE_PERCENT=12
CREDIT_SCORE_THRESHOLD=600

# Score Deltas (used by indexer to update user scores)
SCORE_DELTA_REPAY=15
SCORE_DELTA_DEFAULT=50
SCORE_DELTA_LATE=5

# Indexer Configuration
INDEXER_POLL_INTERVAL_MS=30000
INDEXER_BATCH_SIZE=100
# Maximum ledger lag before /health/deep reports indexer as degraded
INDEXER_HEALTH_LAG_LIMIT=100

# Adaptive scheduler — set to "false" to revert to fixed polling
INDEXER_ADAPTIVE_SCHEDULING=true
# Ledger-lag threshold below which the indexer is considered caught up
INDEXER_CAUGHT_UP_THRESHOLD=50
# Ledger-lag threshold above which the indexer switches to aggressive catch-up mode
INDEXER_AGGRESSIVE_THRESHOLD=100
# Poll interval (ms) in the caught-up / steady-state mode
INDEXER_INTERVAL_CAUGHT_UP_MS=30000
# Poll interval (ms) when moderately behind (lag between thresholds)
INDEXER_INTERVAL_BEHIND_MS=10000
# Poll interval (ms) in aggressive catch-up mode
INDEXER_INTERVAL_CATCH_UP_MS=3000
# Ledgers fetched per poll in caught-up mode
INDEXER_BATCH_SIZE_CAUGHT_UP=100
# Ledgers fetched per poll when moderately behind
INDEXER_BATCH_SIZE_BEHIND=200
# Ledgers fetched per poll in aggressive catch-up mode
INDEXER_BATCH_SIZE_CATCH_UP=500
# Base delay (ms) for exponential back-off on repeated indexer errors
INDEXER_BACKOFF_BASE_MS=5000
# Maximum back-off delay (ms) cap (≈ 2.25 min ceiling)
INDEXER_BACKOFF_MAX_MS=135000

# Default checker (on-chain `check_defaults`)
# How often to scan + submit default checks while the API process is running
DEFAULT_CHECK_INTERVAL_MS=1800000
# Max loans to include per scheduled run (safety valve)
DEFAULT_CHECK_MAX_LOANS_PER_RUN=500
# Number of loan IDs per Soroban transaction
DEFAULT_CHECK_BATCH_SIZE=25
# Max time to wait for a single batch submission before moving on
DEFAULT_CHECK_BATCH_TIMEOUT_MS=300000
# Number of concurrent batches to submit
DEFAULT_CHECK_CONCURRENCY=3
# Polling configuration after submission
DEFAULT_CHECK_POLL_ATTEMPTS=30
DEFAULT_CHECK_POLL_SLEEP_MS=1000
# Must match the deployed contract if it ever changes from the repo default
LOAN_TERM_LEDGERS=17280

# Score reconciliation
SCORE_RECONCILIATION_INTERVAL_MS=3600000
SCORE_RECONCILIATION_MAX_BORROWERS_PER_RUN=500
SCORE_RECONCILIATION_BATCH_SIZE=25
SCORE_RECONCILIATION_AUTOCORRECT_ENABLED=false
SCORE_RECONCILIATION_AUTOCORRECT_THRESHOLD=50

# Authentication
# [required:prod] JWT signing secret. Must be >= 32 chars and not a known
# placeholder (e.g. "changeme", "your-secret-here", "test", "dev").
# Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# [optional] JWT cookie name
JWT_COOKIE_NAME=remitlend_jwt
# [required:prod] Internal service-to-service API key. Must be >= 32 chars and
# not a known placeholder. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me

# RBAC — comma-separated Stellar public keys (G...)
# Wallets listed in ADMIN_WALLETS receive the admin role (admin:all scope).
# Wallets listed in LENDER_WALLETS receive the lender role.
# Any unlisted wallet defaults to borrower.
ADMIN_WALLETS=
LENDER_WALLETS=

# Debugging
# [required:prod] Must be false in production; true is rejected at startup.
EXPOSE_STACK_TRACES=false

# Webhooks
WEBHOOK_REQUEST_TIMEOUT_MS=30000

# Sentry (leave blank to disable; set SENTRY_DSN in staging/production)
SENTRY_DSN=

# OpenTelemetry trace export (leave endpoint blank to disable; docker-compose runs Jaeger at jaeger:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=remitlend-backend
# Trace sampling rate 0..1 (default: 0.2 in production, 1 elsewhere)
OTEL_TRACES_SAMPLE_RATE=

# Notifications
NOTIFICATION_RETENTION_DAYS=90
READ_NOTIFICATION_RETENTION_DAYS=30

# SendGrid Email Configuration
SENDGRID_API_KEY=
FROM_EMAIL=

# Admin Notifications
ADMIN_EMAIL=
ADMIN_WEBHOOK_URL=

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Multi-region DR drill (issue #570)
# Non-production game-day rehearsal of multi-region recovery and failback.
# These flags gate the drill so a standby region cannot submit transactions
# until network and signer controls are explicitly verified.
# Set DR_DRILL_ENABLED=true only in the drill environment (never production).
DR_DRILL_ENABLED=false
# Region this instance is running in (e.g. primary, standby).
DR_DRILL_REGION=primary
# Explicit RTO/RPO targets (minutes) the drill records observed values against.
DR_DRILL_RTO_TARGET_MINUTES=60
DR_DRILL_RPO_TARGET_MINUTES=5
# Standby write gate: when true the standby refuses to submit transactions
# until network + signer controls are verified. Keep true for the drill.
DR_DRILL_STANDBY_WRITE_BLOCKED=true
# Signer control verification must pass before the write gate can be lifted.
DR_DRILL_SIGNER_VERIFIED=false
# Network/routing verification must pass before the write gate can be lifted.
DR_DRILL_NETWORK_VERIFIED=false
# Named incident commander for the drill (required to start a drill).
DR_DRILL_INCIDENT_COMMANDER=
# Rollback/failback criteria: comma-separated checks that must pass before
# failing back to the primary region (e.g. integrity_reconciled,indexer_caught_up).
DR_DRILL_FAILBACK_CRITERIA=integrity_reconciled,indexer_caught_up,rpc_healthy
# Where drill observations and follow-up actions are recorded.
DR_DRILL_REPORT_PATH=./dr-drill-report.json
