# Hermetic test environment for critical full-stack journeys (issue #578).
# No public RPC or production credentials: everything points at local, deterministic services.

NODE_ENV=test

# --- Backend ---
PORT=3001
INTERNAL_API_KEY=test-api-key
JWT_SECRET=test-secret

# --- PostgreSQL (local container) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_test

# --- Redis (local container) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Soroban-compatible hermetic test ledger ---
# Points at the local test ledger only; never a public/mainnet RPC.
STELLAR_NETWORK=standalone
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_HORIZON_URL=http://localhost:8000

# Controlled contract deployments (fixtures deployed by the harness, not live contracts).
SOROBAN_CONTRACT_ID=CDTESTCONTRACT000000000000000000000000000000000000000000

# Wallet fixtures: deterministic test accounts, reset between runs.
STELLAR_TEST_SECRET_KEY=SATEST0000000000000000000000000000000000000000000000000000
STELLAR_TEST_PUBLIC_KEY=GATEST0000000000000000000000000000000000000000000000000000

# Deterministic chain fault injection (delayed/failed/unavailable) without arbitrary sleeps.
CHAIN_FAULT_MODE=none
CHAIN_FAULT_DELAY_MS=0
