{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "performance:budget:mobile": "node scripts/check-mobile-performance-budget.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "start": "next start",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "audit:a11y": "next build && npx axe-playwright",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "generate:api-types": "tsx scripts/generate-api-types.ts",
    "validate:api-contract": "node scripts/check-contract-drift.js --fail-on-breaking"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/next": "^9.5.13",
    "@serwist/precaching": "^9.5.13",
    "@serwist/sw": "^9.5.13",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^10.6.2",
    "@storybook/test": "^8.4.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-playwright": "^2.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "axios": "1.13.5"
  }
}
